@page "/instructor/exams"
@using BlazorApp8.Application.DTOs
@using BlazorApp8.Application.Interfaces
@attribute [Authorize(Roles = "Instructor")]
@rendermode InteractiveServer
@inject IInstructorService InstructorService
@inject NavigationManager NavigationManager

<PageTitle>Manage Exams</PageTitle>

<h3>Manage Exams</h3>

<div class="row mb-4 p-3 border rounded shadow-sm">
    <h4>Create New Exam</h4>
    <EditForm Model="newExam" OnValidSubmit="CreateExam">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Subject</label>
                <InputSelect @bind-Value="newExam.SubjectId" class="form-select" required>
                    <option value="">-- Select Subject --</option>
                    @if (subjects != null)
                    {
                        foreach (var sub in subjects)
                        {
                            <option value="@sub.Id">@sub.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Title</label>
                <InputText @bind-Value="newExam.Title" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Duration (mins)</label>
                <InputNumber @bind-Value="newExam.DurationMinutes" class="form-control" min="1" required />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Create</button>
            </div>
        </div>
    </EditForm>
</div>

@if (exams == null)
{
    <p><em>Loading exams...</em></p>
}
else if (!exams.Any())
{
    <p>No exams created yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in exams)
                {
                    <tr>
                        <td>@exam.Id</td>
                        <td>@exam.Title</td>
                        <td>@exam.SubjectName</td>
                        <td>@exam.DurationMinutes min</td>
                        <td>
                            <a href="instructor/exams/@exam.Id/questions" class="btn btn-sm btn-info">Manage Questions</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ExamDto newExam = new() { DurationMinutes = 5, TotalQuestions = 10 };
    private List<SubjectDto>? subjects;
    private List<ExamDto>? exams;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var subs = await InstructorService.GetAllSubjectsAsync();
        subjects = subs.ToList();

        var exms = await InstructorService.GetAllExamsAsync();
        exams = exms.ToList();
    }

    private async Task CreateExam()
    {
        if (newExam.SubjectId > 0 && !string.IsNullOrWhiteSpace(newExam.Title))
        {
            await InstructorService.CreateExamAsync(newExam);
            newExam = new ExamDto { DurationMinutes = 5, TotalQuestions = 10 }; // Reset
            await LoadData();
        }
    }
}
