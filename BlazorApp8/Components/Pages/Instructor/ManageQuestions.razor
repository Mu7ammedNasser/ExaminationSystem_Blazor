@page "/instructor/exams/{ExamId:int}/questions"
@using BlazorApp8.Application.DTOs
@using BlazorApp8.Application.Interfaces
@attribute [Authorize(Roles = "Instructor")]
@rendermode InteractiveServer
@inject IInstructorService InstructorService
@inject NavigationManager NavigationManager

<PageTitle>Manage Questions</PageTitle>

<div class="mb-3">
    <a href="instructor/exams" class="btn btn-outline-secondary">&larr; Back to Exams</a>
</div>

<h3>Questions for Exam #@ExamId</h3>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Add New Question</h5>
    </div>
    <div class="card-body">
        <EditForm Model="newQuestion" OnValidSubmit="AddQuestion">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Question Text</label>
                <InputTextArea @bind-Value="newQuestion.Text" class="form-control" rows="2" required />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Option A</label>
                    <InputText @bind-Value="newQuestion.OptionA" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Option B</label>
                    <InputText @bind-Value="newQuestion.OptionB" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Option C</label>
                    <InputText @bind-Value="newQuestion.OptionC" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Option D</label>
                    <InputText @bind-Value="newQuestion.OptionD" class="form-control" required />
                </div>
            </div>

            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Correct Answer</label>
                    <InputSelect @bind-Value="newQuestion.CorrectAnswer" class="form-select" required>
                        <option value="">-- Select Correct Option --</option>
                        <option value="A">Option A</option>
                        <option value="B">Option B</option>
                        <option value="C">Option C</option>
                        <option value="D">Option D</option>
                    </InputSelect>
                </div>
                <div class="col-md-8 text-end">
                    <button type="submit" class="btn btn-success">Add Question</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (questions == null)
{
    <p><em>Loading questions...</em></p>
}
else if (!questions.Any())
{
    <p>No questions added yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var (q, index) in questions.Select((item, index) => (item, index)))
        {
            <div class="list-group-item list-group-item-action mb-2 border rounded shadow-sm">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">Q@(index + 1): @q.Text</h5>
                    <small>ID: @q.Id</small>
                </div>
                <div class="mt-2">
                    <div class=@(q.CorrectAnswer == "A" ? "fw-bold text-success" : "")>A) @q.OptionA</div>
                    <div class=@(q.CorrectAnswer == "B" ? "fw-bold text-success" : "")>B) @q.OptionB</div>
                    <div class=@(q.CorrectAnswer == "C" ? "fw-bold text-success" : "")>C) @q.OptionC</div>
                    <div class=@(q.CorrectAnswer == "D" ? "fw-bold text-success" : "")>D) @q.OptionD</div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public int ExamId { get; set; }

    private QuestionDto newQuestion = new();
    private List<QuestionDto>? questions;

    protected override async Task OnInitializedAsync()
    {
        newQuestion.ExamId = ExamId;
        await LoadQuestions();
    }

    private async Task LoadQuestions()
    {
        var result = await InstructorService.GetQuestionsByExamAsync(ExamId);
        questions = result.ToList();
    }

    private async Task AddQuestion()
    {
        if (!string.IsNullOrWhiteSpace(newQuestion.Text) && !string.IsNullOrWhiteSpace(newQuestion.CorrectAnswer))
        {
            await InstructorService.AddQuestionAsync(newQuestion);
            newQuestion = new QuestionDto { ExamId = ExamId }; // Reset
            await LoadQuestions();
        }
    }
}
