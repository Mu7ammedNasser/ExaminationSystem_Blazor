@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-panel">
        <header class="topbar">
            <div class="topbar-title-wrap">
                <p class="topbar-eyebrow">Examation System</p>
                <h1 class="topbar-title">Learning & Assessment Dashboard</h1>
            </div>
            <a class="topbar-link" href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noreferrer">Docs</a>
        </header>

        <article class="content-container">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">??</span>
</div>
